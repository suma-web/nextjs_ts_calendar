generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Schedule {
  id         String   @id @default(uuid())
  ownerEmail String?
  date       DateTime
  title      String
  startTime  DateTime
  endTime    DateTime
  createdAt  DateTime @default(now())

  @@index([ownerEmail, startTime])
}
